{
  "name": "bitbucket_list_prs",
  "description": "List pull requests for a Bitbucket repository",
  "destructive": false,
  "inputSchema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "description": "Repository slug"
      },
      "state": {
        "type": "string",
        "enum": [
          "OPEN",
          "MERGED",
          "DECLINED",
          "SUPERSEDED"
        ],
        "description": "Filter by PR state (default: OPEN)"
      },
      "limit": {
        "type": "number",
        "description": "Results per page (default: 25)"
      }
    },
    "required": [
      "repo"
    ]
  }
}
